{
  "name": "lingoweave",
  "version": "0.3.0",
  "description": "Drop-in automatic translation for your whole website. Translates every element (dropdowns, submenus, modals, tooltips and anything injected later), pierces Shadow DOM, and never breaks React.",
  "keywords": [
    "translate",
    "translation",
    "auto-translate",
    "automatic-translation",
    "website-translation",
    "dom-translation",
    "i18n",
    "internationalization",
    "localization",
    "l10n",
    "multilingual",
    "mutationobserver",
    "shadow-dom",
    "google-translate-alternative",
    "translator",
    "rtl"
  ],
  "author": "harshit-d3v",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshit-d3v/lingoweave.git"
  },
  "homepage": "https://github.com/harshit-d3v/lingoweave#readme",
  "bugs": {
    "url": "https://github.com/harshit-d3v/lingoweave/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "./dist/lingoweave.global.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/lingoweave.global.js",
  "jsdelivr": "./dist/lingoweave.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js",
      "require": "./dist/providers.cjs"
    },
    "./switcher": {
      "types": "./dist/switcher.d.ts",
      "import": "./dist/switcher.js",
      "require": "./dist/switcher.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "build:demo": "npm run build && node -e \"require('fs').copyFileSync('dist/lingoweave.global.js','demo/lingoweave.global.js')\"",
    "pretest:browser": "npm run build:demo",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.0.0",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "size-limit": [
    {
      "name": "core",
      "path": "dist/index.js",
      "limit": "12 kB"
    }
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
